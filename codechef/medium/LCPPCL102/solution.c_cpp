#include <iostream>
using namespace std;

int main() {
    int a,b,c,d;
    cin>>a>>b>>c>>d;
    float p = a - c; // price of first tv after discount was wrong
    float q = b - d; // price of second tv after discount was wrong
    if(p<q){
       cout<<"First"<<endl;
    }
    else if(p>q){
       cout<<"Second"<<endl;
    }
    else if(p==q) {
       cout<<"Any"<<endl;
    }
	
}
